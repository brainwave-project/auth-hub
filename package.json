{
  "name": "auth-hub",
  "version": "1.0.0",
  "description": "Centralized Identity Management using Node.js &amp; Express. Acts as a facade for Keycloak with JWT-based security and zero-trust internal gRPC calls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint . --ext .ts,.js",
    "dev": "nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainwave-project/auth-hub.git"
  },
  "keywords": [
    "auth-hub",
    "identity-management",
    "keycloak",
    "jwt"
  ],
  "author": "Ahmad Awad",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0"
  },
  "bugs": {
    "url": "https://github.com/brainwave-project/auth-hub/issues"
  },
  "homepage": "https://github.com/brainwave-project/auth-hub#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "jose": "^5.9.6",
    "prom-client": "^15.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
