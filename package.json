{
  "name": "auth-hub",
  "version": "1.0.0",
  "description": "Centralized Identity Management using Node.js & Express. Acts as a facade for Keycloak with JWT-based security and zero-trust internal gRPC calls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@brainwave-project/core": "^1.0.0",
    "@grpc/grpc-js": "^1.12.4",
    "kafkajs": "^2.2.4",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "jose": "^5.9.6",
    "pino": "^9.0.0",
    "prom-client": "^15.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.16.0",
    "typescript": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainwave-project/auth-hub.git"
  },
  "keywords": ["auth-hub", "identity-management", "keycloak", "jwt"],
  "author": "Ahmad Awad",
  "license": "MIT"
}
