PORT=3000
NODE_ENV=development
SERVICE_NAME=AuthHub
DB_HOST=localhost
DB_USER=admin
DB_PASS=secret

# Keycloak (optional; when set, /api/auth/* and /api/tokens/* use it)
# Example: local-dev realm with client user-hub (see realm export for testuser/password)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=local-dev
KEYCLOAK_CLIENT_ID=user-hub
KEYCLOAK_CLIENT_SECRET=my-secret
# Base URL for redirect_uri; callback = this + /api/auth/callback (e.g. http://localhost:3000/api/auth/callback)
KEYCLOAK_REDIRECT_BASE_URL=http://localhost:3000

# gRPC port for service-to-service (e.g. ValidateToken). Omit to disable gRPC server.
GRPC_PORT=50051